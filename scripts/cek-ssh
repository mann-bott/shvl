#!/usr/bin/env bash
# ==============================================================================
# SHVL - Multi-Protocol Unified SSH & OpenVPN Live Session Monitor
# Target OS: Ubuntu 24.04 LTS, Debian 13, Alpine Linux
# Supported Protocols:
#   1. SSH WebSocket (HTTP & TLS / Cloudflare CDN)
#   2. Direct SSH SSL / TLS / SNI (Port 443 / 8443)
#   3. Direct Dropbear TCP (Port 109 / 143)
#   4. Direct OpenSSH (Port 22)
#   5. OpenVPN TCP (Port 1194 / 443)
# Features:
#   - Multi-login counting & IP Limit violation indicator
#   - Real Client IP, SIM Provider / ISP detection (XL, Telkomsel, Indosat, dll)
#   - Geolocation (City, Country)
#   - Usage per connection (TX / RX / Total Bandwidth)
#   - Active websites & destinations accessed (Meta, Google, Telegram, etc.)
# ==============================================================================

set -e

python3 - << 'EOF'
import sys, os, time, sqlite3, json, urllib.request, subprocess, re, socket

CYAN   = "\033[0;36m"
GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
BLUE   = "\033[0;34m"
PURPLE = "\033[0;35m"
BOLD   = "\033[1m"
WHITE  = "\033[1;37m"
GRAY   = "\033[0;90m"
NC     = "\033[0m"

os.system("clear 2>/dev/null || true")

print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f"       {BOLD}{PURPLE}◈ SHVL MULTI-PROTOCOL LIVE MONITOR (SSH, SSL, OVPN, WS) ◈{NC}")
print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")

# 1. Baca Database Akun SSH
db_path = "/etc/shvl/shvl.db"
accounts = {}
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        c = conn.cursor()
        c.execute("SELECT username, credential, limit_ip, quota_gb, expired_at, status, usage_tx, usage_rx FROM accounts WHERE proto='ssh'")
        for r in c.fetchall():
            accounts[r[0]] = {
                "password": r[1],
                "limit_ip": r[2],
                "quota_gb": r[3],
                "expired_at": r[4],
                "status": r[5],
                "usage_tx": r[6] if len(r) > 6 and r[6] else 0,
                "usage_rx": r[7] if len(r) > 7 and r[7] else 0
            }
        conn.close()
    except Exception:
        pass

# 2. GeoIP & SIM Provider Lookup (Cached)
GEO_CACHE_FILE = "/tmp/shvl_geo_cache.json"
geo_cache = {}
if os.path.exists(GEO_CACHE_FILE):
    try:
        with open(GEO_CACHE_FILE, "r") as f:
            geo_cache = json.load(f)
    except Exception:
        geo_cache = {}

def get_isp_and_location(ip):
    if not ip or ip.startswith("127.") or ip == "::1":
        return "Localhost / Loopback", "Localhost"
    if ip in geo_cache:
        return geo_cache[ip].get("provider", "Unknown"), geo_cache[ip].get("location", "Unknown")

    try:
        url = f"http://ip-api.com/json/{ip}?fields=status,country,city,regionName,isp,org,as"
        req = urllib.request.Request(url, headers={"User-Agent": "shvl-monitor/2.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode())
            if data.get("status") == "success":
                asn = data.get("as", "")
                isp = data.get("isp", "")
                city = data.get("city", "")
                country = data.get("country", "")
                region = data.get("regionName", "")

                combined = (asn + " " + isp).upper()
                if "XL" in combined or "EXCELCOMINDO" in combined or "AXIS" in combined:
                    provider = "XL Axiata (XL / AXIS)"
                elif "TELKOMSEL" in combined or "TELEKOMUNIKASI SELULAR" in combined:
                    provider = "Telkomsel (by.U / Halo)"
                elif "INDOSAT" in combined or "HUTCHISON" in combined or "TRI" in combined or "THREE" in combined:
                    provider = "Indosat Ooredoo Hutchison (IM3 / Tri)"
                elif "SMARTFREN" in combined or "SMART TELECOM" in combined:
                    provider = "Smartfren"
                elif "BIZNET" in combined:
                    provider = "Biznet Networks"
                elif "FIRST MEDIA" in combined or "LINK NET" in combined:
                    provider = "First Media"
                elif "MYREPUBLIC" in combined:
                    provider = "MyRepublic"
                elif "INDIHOME" in combined or "TELKOM" in combined:
                    provider = "Telkom IndiHome"
                else:
                    provider = isp if isp else "Internet Provider"

                loc_parts = []
                if city: loc_parts.append(city)
                elif region: loc_parts.append(region)
                if country: loc_parts.append(country)
                loc = ", ".join(loc_parts) if loc_parts else "Unknown Location"

                geo_cache[ip] = {"provider": provider, "location": loc}
                try:
                    with open(GEO_CACHE_FILE, "w") as f:
                        json.dump(geo_cache, f)
                except Exception:
                    pass
                return provider, loc
    except Exception:
        pass
    return "Internet Provider", "Lokasi Tidak Diketahui"

# 3. Inspeksi Aktivitas Website / Trafik Keluar Berdasarkan PID
DNS_CACHE = {}
def parse_ss_peer(line):
    parts = line.split()
    if not parts:
        return None, None
    if parts[0] in ["ESTAB", "SYN-SENT", "SYN-RECV", "FIN-WAIT-1", "FIN-WAIT-2", "TIME-WAIT", "CLOSE", "CLOSE-WAIT", "LAST-ACK", "LISTEN", "CLOSING"]:
        if len(parts) >= 5:
            return parts[3], parts[4]
    else:
        if len(parts) >= 4:
            return parts[2], parts[3]
    return None, None

def get_pid_destinations(pid):
    if not pid or not os.path.exists(f"/proc/{pid}"):
        return []
    dests = []
    try:
        res = subprocess.run(["ss", "-ntpH", "state", "established"], capture_output=True, text=True)
        for line in res.stdout.splitlines():
            if f"pid={pid}" in line:
                local, peer = parse_ss_peer(line)
                if peer and not peer.startswith("127.0.0.1") and ":" in peer:
                    ip, port = peer.rsplit(":", 1)
                    dests.append((ip, port))
    except Exception:
        pass

    unique = list(set(dests))[:6]
    labels = []
    for ip, port in unique:
        service = None
        if ip in DNS_CACHE:
            service = DNS_CACHE[ip]
        else:
            try:
                host = socket.gethostbyaddr(ip)[0]
                if "facebook" in host or "fbcdn" in host: service = "Meta / Facebook"
                elif "1e100" in host or "google" in host: service = "Google / YouTube"
                elif "telegram" in host: service = "Telegram"
                elif "cloudfront" in host or "aws" in host: service = "AWS / CloudFront"
                elif "alibaba" in host or "aliyun" in host: service = "Alibaba Cloud"
                elif "cloudflare" in host: service = "Cloudflare"
                else: service = host
            except Exception:
                if ip.startswith("91.108.") or ip.startswith("149.154."):
                    service = "Telegram Messenger"
                elif ip.startswith("157.240.") or ip.startswith("57.144."):
                    service = "Meta (Facebook/WhatsApp)"
                elif ip.startswith("172.253.") or ip.startswith("142.250.") or ip.startswith("142.251.") or ip.startswith("74.125.") or ip.startswith("64.233."):
                    service = "Google Services"
                elif port == "443":
                    service = "Web HTTPS (Encrypted)"
                elif port == "80":
                    service = "Web HTTP"
                elif port in ["5228", "5229", "5230"]:
                    service = "Google FCM Push"
                elif port == "7300":
                    service = "BadVPN UDPGW (Gaming/Call)"
                else:
                    service = f"Remote Port {port}"
            DNS_CACHE[ip] = service
        labels.append(f"{service} ({ip}:{port})")
    return labels

def fmt_bytes(b):
    if b >= 1024**3: return f"{b / (1024**3):.2f} GB"
    if b >= 1024**2: return f"{b / (1024**2):.2f} MB"
    if b >= 1024: return f"{b / 1024:.2f} KB"
    return f"{b} B"

def fmt_remaining(exp_time):
    now = int(time.time())
    if exp_time <= now:
        return "Expired"
    diff = exp_time - now
    days = diff // 86400
    hours = (diff % 86400) // 3600
    mins = (diff % 3600) // 60
    if days > 0:
        return f"{days}h {hours}j"
    elif hours > 0:
        return f"{hours}j {mins}m"
    else:
        return f"{mins}m"

def fmt_duration(sec):
    if sec <= 0: return "Active"
    h = sec // 3600
    m = (sec % 3600) // 60
    s = sec % 60
    if h > 0:
        return f"{h}j {m}m {s}d"
    elif m > 0:
        return f"{m}m {s}d"
    else:
        return f"{s}d"

def get_pid_stats(pid):
    dur_str = "Active"
    rx_str = "-"
    tx_str = "-"
    tot_str = "-"
    if pid and os.path.exists(f"/proc/{pid}"):
        try:
            mtime = os.path.getmtime(f"/proc/{pid}")
            sec = max(0, int(time.time() - mtime))
            dur_str = fmt_duration(sec)
        except Exception:
            pass
        if os.path.exists(f"/proc/{pid}/io"):
            try:
                rchar, wchar = 0, 0
                with open(f"/proc/{pid}/io", "r") as f:
                    for l in f:
                        if l.startswith("rchar:"):
                            rchar = int(l.split()[1])
                        elif l.startswith("wchar:"):
                            wchar = int(l.split()[1])
                if rchar > 0 or wchar > 0:
                    rx_str = fmt_bytes(rchar)
                    tx_str = fmt_bytes(wchar)
                    tot_str = fmt_bytes(rchar + wchar)
            except Exception:
                pass
    return dur_str, tx_str, rx_str, tot_str

all_collected_sessions = []
processed_dropbear_pids = set()

# ==============================================================================
# CHANNEL 1: SSH WebSocket (via ssh-ws API :8081)
# ==============================================================================
ws_sessions = []
user_stats = {}
try:
    req = urllib.request.urlopen("http://127.0.0.1:8081/api/sessions", timeout=2)
    raw = json.loads(req.read().decode())
    data = raw.get("data", raw)
    ws_sessions = data.get("sessions", [])
    user_stats = data.get("user_stats", {})
except Exception:
    pass

# ==============================================================================
# CHANNEL 2, 3: Dropbear Auth Logs (Journalctl & Syslog)
# ==============================================================================
dropbear_map = {} # local_port -> (user, pid)
direct_dropbear_events = []

def parse_dropbear_auth():
    lines = []
    try:
        res = subprocess.run(["journalctl", "-u", "dropbear", "-n", "300", "--no-pager"], capture_output=True, text=True)
        if res.returncode == 0:
            lines.extend(res.stdout.splitlines())
    except Exception:
        pass

    for p in ["/var/log/auth.log", "/var/log/messages", "/var/log/secure"]:
        if os.path.exists(p):
            try:
                with open(p, "r", errors="ignore") as f:
                    lines.extend(f.readlines()[-300:])
            except Exception:
                pass

    for line in lines:
        if "auth succeeded" in line:
            m = re.search(r"dropbear\[(\d+)\].*(?:Password|Pubkey) auth succeeded for '([^']+)' from ([^:]+):(\d+)", line)
            if m:
                pid = int(m.group(1))
                user = m.group(2)
                from_ip = m.group(3)
                port = m.group(4)
                if os.path.exists(f"/proc/{pid}"):
                    dropbear_map[port] = (user, pid)
                    # Jika from_ip bukan localhost, berarti koneksi langsung ke port 109/143
                    if from_ip not in ["127.0.0.1", "localhost", "::1"]:
                        direct_dropbear_events.append({
                            "user": user,
                            "pid": pid,
                            "client_ip": from_ip,
                            "client_port": port
                        })

parse_dropbear_auth()

# Kumpulkan HAProxy frontend clients di port 443 untuk Direct SSL matching
haproxy_clients_443 = []
try:
    res = subprocess.run(["ss", "-ntpH", "sport = :443 or sport = :8443"], capture_output=True, text=True)
    for line in res.stdout.splitlines():
        if "haproxy" in line:
            local, peer = parse_ss_peer(line)
            if peer and not peer.startswith("127.0.0.1") and ":" in peer:
                ip, port = peer.rsplit(":", 1)
                haproxy_clients_443.append((ip, port))
except Exception:
    pass

# Proses WebSocket Sessions
for s in ws_sessions:
    port = str(s.get("proxy_to_ssh_port", ""))
    if port in dropbear_map:
        s["username"], s["pid"] = dropbear_map[port]
        processed_dropbear_pids.add(s["pid"])
    elif s.get("username") in ["detecting...", "unknown", "N/A", ""]:
        remaining = [p for p, (u, pid) in dropbear_map.items() if pid not in processed_dropbear_pids]
        if len(remaining) == 1:
            u, pid = dropbear_map[remaining[0]]
            s["username"] = u
            s["pid"] = pid
            processed_dropbear_pids.add(pid)

    u = s.get("username", "")
    if u and u not in ["detecting...", "unknown", "N/A"]:
        dur = s.get("duration", "Active")
        tx = s.get("tx_formatted", "0 B")
        rx = s.get("rx_formatted", "0 B")
        tot = s.get("total_formatted", "0 B")
        pid = s.get("pid", 0)
        if pid:
            p_dur, p_tx, p_rx, p_tot = get_pid_stats(pid)
            if tx in ["0 B", "-"] and rx in ["0 B", "-"] and p_tot not in ["0 B", "-"]:
                tx, rx, tot = p_tx, p_rx, p_tot
            if dur in ["Active", "0s"]:
                dur = p_dur

        all_collected_sessions.append({
            "username": u,
            "type": "SSH WebSocket (HTTP/TLS)",
            "client_ip": s.get("real_client_ip", "127.0.0.1"),
            "client_port": s.get("real_client_port", "-"),
            "duration": dur,
            "tx": tx,
            "rx": rx,
            "total": tot,
            "pid": pid
        })

# Proses Direct Dropbear (TCP 109/143)
for d in direct_dropbear_events:
    if d["pid"] not in processed_dropbear_pids:
        processed_dropbear_pids.add(d["pid"])
        dur, tx, rx, tot = get_pid_stats(d["pid"])
        all_collected_sessions.append({
            "username": d["user"],
            "type": "Direct Dropbear TCP (Port 109/143)",
            "client_ip": d["client_ip"],
            "client_port": d["client_port"],
            "duration": dur,
            "tx": tx,
            "rx": rx,
            "total": tot,
            "pid": d["pid"]
        })

# Proses Direct SSH SSL / TLS / SNI (Lewat HAProxy port 443 -> Dropbear 109)
for port, (user, pid) in dropbear_map.items():
    if pid not in processed_dropbear_pids:
        processed_dropbear_pids.add(pid)
        matched_ip = "127.0.0.1"
        matched_port = "-"
        if haproxy_clients_443:
            matched_ip, matched_port = haproxy_clients_443.pop(0)

        dur, tx, rx, tot = get_pid_stats(pid)
        all_collected_sessions.append({
            "username": user,
            "type": "Direct SSH SSL / TLS / SNI (Port 443)",
            "client_ip": matched_ip,
            "client_port": matched_port,
            "duration": dur,
            "tx": tx,
            "rx": rx,
            "total": tot,
            "pid": pid
        })

# ==============================================================================
# CHANNEL 4: OpenSSH Direct (Port 22)
# ==============================================================================
try:
    res = subprocess.run(["ps", "-eo", "pid,user,args"], capture_output=True, text=True)
    for line in res.stdout.splitlines():
        if "sshd:" in line:
            for acc_user in accounts.keys():
                if f"sshd: {acc_user}" in line or f"sshd: {acc_user}@" in line:
                    parts = line.split()
                    pid = int(parts[0])
                    sshd_ip = "127.0.0.1"
                    sshd_port = "22"
                    try:
                        res_ss = subprocess.run(["ss", "-ntpH", f"pid = {pid}"], capture_output=True, text=True)
                        for ss_line in res_ss.stdout.splitlines():
                            local, peer = parse_ss_peer(ss_line)
                            if peer and not peer.startswith("127.0.0.1") and ":" in peer:
                                sshd_ip, sshd_port = peer.rsplit(":", 1)
                                break
                    except Exception:
                        pass

                    dur, tx, rx, tot = get_pid_stats(pid)
                    all_collected_sessions.append({
                        "username": acc_user,
                        "type": "OpenSSH Direct (Port 22)",
                        "client_ip": sshd_ip,
                        "client_port": sshd_port,
                        "duration": dur,
                        "tx": tx,
                        "rx": rx,
                        "total": tot,
                        "pid": pid
                    })
except Exception:
    pass

# ==============================================================================
# CHANNEL 5: OpenVPN TCP (Port 1194 / 443)
# ==============================================================================
openvpn_status_files = [
    "/var/log/openvpn-status.log",
    "/run/openvpn/server.status",
    "/var/log/openvpn/server.status",
    "/etc/openvpn/server.status"
]
for sf in openvpn_status_files:
    if os.path.exists(sf):
        try:
            with open(sf, "r") as f:
                content = f.read()
            lines = content.splitlines()
            in_client_list = False
            for line in lines:
                if line.startswith("Common Name,Real Address"):
                    in_client_list = True
                    continue
                if line.startswith("ROUTING TABLE") or line.startswith("GLOBAL STATS"):
                    in_client_list = False
                    break
                if in_client_list and "," in line:
                    parts = line.split(",")
                    if len(parts) >= 5:
                        cname = parts[0]
                        real_addr = parts[1]
                        bytes_rx = int(parts[2])
                        bytes_tx = int(parts[3])
                        since = parts[4]
                        if real_addr and ":" in real_addr:
                            ip, port = real_addr.rsplit(":", 1)
                        else:
                            ip, port = real_addr, "-"

                        all_collected_sessions.append({
                            "username": cname,
                            "type": "OpenVPN TCP (Port 1194 / 443)",
                            "client_ip": ip,
                            "client_port": port,
                            "duration": since,
                            "tx": fmt_bytes(bytes_tx),
                            "rx": fmt_bytes(bytes_rx),
                            "total": fmt_bytes(bytes_tx + bytes_rx),
                            "pid": 0
                        })
        except Exception:
            pass
        break

# Kelompokkan sesi per username
user_sessions = {}
for s in all_collected_sessions:
    u = s.get("username", "unknown")
    if u not in user_sessions:
        user_sessions[u] = []
    user_sessions[u].append(s)

# Simpan cache sesi aktif untuk limiter daemon
try:
    with open("/tmp/shvl_active_sessions.json", "w") as f:
        json.dump({"status": "success", "sessions": all_collected_sessions}, f)
except Exception:
    pass

now = int(time.time())
online_user_count = len(user_sessions)
total_active_conns = len(all_collected_sessions)

if user_sessions:
    for u, sessions in user_sessions.items():
        acc = accounts.get(u, {"limit_ip": 1, "quota_gb": 0, "expired_at": now + 86400, "status": "active"})
        limit_ip = acc.get("limit_ip", 1)
        quota_gb = acc.get("quota_gb", 0)
        exp_time = acc.get("expired_at", now)

        unique_ips = list(set([s.get("client_ip", "127.0.0.1") for s in sessions if s.get("client_ip") and s.get("client_ip") != "127.0.0.1"]))
        if not unique_ips:
            unique_ips = list(set([s.get("client_ip", "127.0.0.1") for s in sessions]))
        ip_count = len(unique_ips)

        if limit_ip > 0 and ip_count > limit_ip:
            ip_status = f"{RED}{ip_count} / {limit_ip} IP [MELEBIHI LIMIT - AUTO LOCK 5M]{NC}"
        elif limit_ip > 0:
            ip_status = f"{GREEN}{ip_count} / {limit_ip} IP [NORMAL]{NC}"
        else:
            ip_status = f"{GREEN}{ip_count} IP [UNLIMITED]{NC}"

        days_left = max(0, int((exp_time - now) / 86400))
        exp_str = time.strftime("%Y-%m-%d %H:%M", time.localtime(exp_time))

        quota_str = f"{quota_gb} GB" if quota_gb > 0 else "Unlimited"
        acc_usage = acc.get("usage_tx", 0) + acc.get("usage_rx", 0)
        usage_user_str = f"{fmt_bytes(acc_usage)} / {quota_str}"
        rem_user_str = fmt_remaining(exp_time)
        exp_full_str = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(exp_time))

        u_stat = user_stats.get(u, {})
        tot_tx = u_stat.get("total_tx", 0)
        tot_rx = u_stat.get("total_rx", 0)
        tot_bytes = u_stat.get("total_bytes", tot_tx + tot_rx)

        tx_str = fmt_bytes(tot_tx) if tot_tx > 0 else "-"
        rx_str = fmt_bytes(tot_rx) if tot_rx > 0 else "-"
        bw_str = fmt_bytes(tot_bytes) if tot_bytes > 0 else "-"

        print(f"\n{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
        print(f" {BOLD}USER ONLINE:{NC} {GREEN}{u}{NC}  │  {BOLD}Status Login:{NC} {ip_status}")
        print(f"{CYAN}─────────────────────────────────────────────────────────────────────────────{NC}")
        print(f"  {WHITE}Usage / Batas{NC}  : {YELLOW}{usage_user_str}{NC}")
        print(f"  {WHITE}Expired Pada{NC}   : {exp_full_str} ({GREEN}{rem_user_str}{NC})")
        if tot_bytes > 0:
            print(f"  {WHITE}Total Bandwidth{NC}: {GREEN}{bw_str}{NC} (Upload: {tx_str} │ Download: {rx_str})")

        # Rincian per koneksi
        for idx, s in enumerate(sessions, 1):
            client_ip = s.get("client_ip", "127.0.0.1")
            client_port = s.get("client_port", "-")
            duration = s.get("duration", "0s")
            tx = s.get("tx", "0 B")
            rx = s.get("rx", "0 B")
            total = s.get("total", "0 B")
            proto_type = s.get("type", "SSH Tunnel")
            pid = s.get("pid", 0)

            provider, location = get_isp_and_location(client_ip)
            destinations = get_pid_destinations(pid)

            print(f"\n  {BOLD}{CYAN}┌─ [ KONEKSI AKTIF #{idx} ] ──────────────────────────────────────────{NC}")
            print(f"  │ {WHITE}Protokol Tunnel{NC} : {GREEN}{proto_type}{NC}")
            print(f"  │ {WHITE}Real Client IP{NC}  : {YELLOW}{client_ip}:{client_port}{NC}")
            print(f"  │ {WHITE}SIM / Provider{NC}  : {BOLD}{PURPLE}{provider}{NC}")
            print(f"  │ {WHITE}Lokasi Asal IP{NC}  : {GREEN}{location}{NC}")
            print(f"  │ {WHITE}Durasi Online{NC}   : {duration}")
            print(f"  │ {WHITE}Penggunaan Data{NC} : TX: {tx} │ RX: {rx} │ Total: {BOLD}{total}{NC}")
            if pid:
                print(f"  │ {WHITE}Process Daemon{NC}  : PID {pid}")
            print(f"  │ {WHITE}Aktivitas Trafik{NC}:")
            if destinations:
                for d in destinations:
                    print(f"  │   • {GREEN}{d}{NC}")
            else:
                print(f"  │   • {GRAY}(Idle / Menunggu aktivitas browsing){NC}")
            print(f"  {BOLD}{CYAN}└───────────────────────────────────────────────────────────────────{NC}")
else:
    print(f"\n {YELLOW}[i] Tidak ada sesi SSH / OpenVPN yang sedang aktif saat ini.{NC}\n")

# 7. Tabel Semua Akun SSH
print(f"\n{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f"                                   {BOLD}DAFTAR SEMUA AKUN SSH TERDAFTAR{NC}")
print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f" {BOLD}{'NO':<4} {'USERNAME':<16} {'LIMIT IP':<10} {'USAGE / BATAS':<22} {'EXPIRED PADA':<20} {'SISA WAKTU':<14} {'STATUS':<10}{NC}")
print(f"{CYAN}────────────────────────────────────────────────────────────────────────────────────────────────────{NC}")

if accounts:
    for idx, (uname, acc) in enumerate(sorted(accounts.items()), 1):
        lip = f"{acc['limit_ip']} IP" if acc['limit_ip'] > 0 else "Unlimited"
        qta = f"{acc['quota_gb']} GB" if acc['quota_gb'] > 0 else "Unlimited"
        acc_usage = acc.get("usage_tx", 0) + acc.get("usage_rx", 0)
        usage_disp = f"{fmt_bytes(acc_usage)} / {qta}"
        ex_t = acc['expired_at']
        rem_disp = fmt_remaining(ex_t)
        ex_full = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ex_t))

        status = acc['status'].upper()
        if ex_t <= now or acc['status'] == "expired":
            col_stat = YELLOW
            status = "EXPIRED"
        elif acc['status'] == "locked":
            col_stat = RED
            status = "LOCKED"
        else:
            col_stat = GREEN

        is_online = f" {GREEN}●{NC}" if uname in user_sessions else "  "
        print(f" [{idx:<2}]{is_online}{uname:<14} {lip:<10} {usage_disp:<22} {ex_full:<20} {rem_disp:<14} {col_stat}{status:<10}{NC}")
else:
    print(f" {YELLOW}Belum ada akun SSH yang terdaftar di database.{NC}")

print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f" {WHITE}Total Akun SSH:{NC} {GREEN}{len(accounts)}{NC}  │  {WHITE}User Online:{NC} {GREEN}{online_user_count}{NC}  │  {WHITE}Total Sesi Aktif:{NC} {GREEN}{total_active_conns}{NC}\n")

