#!/usr/bin/env bash
# ==============================================================================
# SHVL - Real-Time VLESS Live Connection & Multi-Login Monitor
# Target OS: Ubuntu 24.04 LTS & Debian 13 & Alpine Linux
# Supported Protocols:
#   - VLESS WebSocket (WS TLS / Cloudflare CDN)
#   - VLESS HTTPUpgrade (gRPC / HTTP)
#   - VLESS XHTTP (Next-Gen)
# Features:
#   - Multi-login counting & IP Limit violation indicator
#   - Real Client IP, SIM Provider / ISP detection (XL, Telkomsel, Indosat, dll)
#   - Geolocation (City, Country)
#   - Inbound Protocol tagging & Last Seen / Request Hits
#   - Active websites & destinations accessed (Meta, Google, Telegram, etc.)
# ==============================================================================

set -e

python3 - << 'EOF'
import sys, os, time, sqlite3, json, re, urllib.request

CYAN   = "\033[0;36m"
GREEN  = "\033[0;32m"
YELLOW = "\033[1;33m"
RED    = "\033[0;31m"
BLUE   = "\033[0;34m"
PURPLE = "\033[0;35m"
BOLD   = "\033[1m"
WHITE  = "\033[1;37m"
GRAY   = "\033[0;90m"
NC     = "\033[0m"

os.system("clear 2>/dev/null || true")

print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f"         {BOLD}{PURPLE}◈ SHVL REAL-TIME VLESS LIVE SESSION & TRAFFIC MONITOR ◈{NC}")
print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")

# 1. GeoIP & SIM Provider Lookup (Cached)
GEO_CACHE_FILE = "/tmp/shvl_geo_cache.json"
geo_cache = {}
if os.path.exists(GEO_CACHE_FILE):
    try:
        with open(GEO_CACHE_FILE, "r") as f:
            geo_cache = json.load(f)
    except Exception:
        geo_cache = {}

def get_isp_and_location(ip):
    if not ip or ip.startswith("127.") or ip == "::1":
        return "Localhost / Loopback", "Localhost"
    if ip in geo_cache:
        return geo_cache[ip].get("provider", "Unknown"), geo_cache[ip].get("location", "Unknown")

    try:
        url = f"http://ip-api.com/json/{ip}?fields=status,country,city,regionName,isp,org,as"
        req = urllib.request.Request(url, headers={"User-Agent": "shvl-monitor/2.0"})
        with urllib.request.urlopen(req, timeout=1.5) as resp:
            data = json.loads(resp.read().decode())
            if data.get("status") == "success":
                asn = data.get("as", "")
                isp = data.get("isp", "")
                city = data.get("city", "")
                country = data.get("country", "")
                region = data.get("regionName", "")

                combined = (asn + " " + isp).upper()
                if "XL" in combined or "EXCELCOMINDO" in combined or "AXIS" in combined:
                    provider = "XL Axiata (XL / AXIS)"
                elif "TELKOMSEL" in combined or "TELEKOMUNIKASI SELULAR" in combined:
                    provider = "Telkomsel (by.U / Halo)"
                elif "INDOSAT" in combined or "HUTCHISON" in combined or "TRI" in combined or "THREE" in combined:
                    provider = "Indosat Ooredoo Hutchison (IM3 / Tri)"
                elif "SMARTFREN" in combined or "SMART TELECOM" in combined:
                    provider = "Smartfren"
                elif "BIZNET" in combined:
                    provider = "Biznet Networks"
                elif "FIRST MEDIA" in combined or "LINK NET" in combined:
                    provider = "First Media"
                elif "MYREPUBLIC" in combined:
                    provider = "MyRepublic"
                elif "INDIHOME" in combined or "TELKOM" in combined:
                    provider = "Telkom IndiHome"
                else:
                    provider = isp if isp else "Internet Provider"

                loc_parts = []
                if city: loc_parts.append(city)
                elif region: loc_parts.append(region)
                if country: loc_parts.append(country)
                loc = ", ".join(loc_parts) if loc_parts else "Unknown Location"

                geo_cache[ip] = {"provider": provider, "location": loc}
                try:
                    with open(GEO_CACHE_FILE, "w") as f:
                        json.dump(geo_cache, f)
                except Exception:
                    pass
                return provider, loc
    except Exception:
        pass
    return "Internet Provider", "Lokasi Tidak Diketahui"

# 2. Klasifikasi Website / Layanan Target
def classify_target(host, port, transport):
    h = host.lower()
    if "facebook" in h or "fbcdn" in h:
        return f"Meta / Facebook ({host}:{port})"
    elif "whatsapp" in h or "wa.me" in h:
        return f"Meta / WhatsApp ({host}:{port})"
    elif "instagram" in h:
        return f"Meta / Instagram ({host}:{port})"
    elif "youtube" in h or "googlevideo" in h or "ytimg" in h:
        return f"Google / YouTube ({host}:{port})"
    elif "google" in h or "1e100" in h or "gstatic" in h or "android" in h:
        if port == "5228" or "mtalk" in h:
            return f"Google FCM Push ({host}:{port})"
        return f"Google Services ({host}:{port})"
    elif "telegram" in h or "t.me" in h or host.startswith("149.154.") or host.startswith("91.108."):
        return f"Telegram Messenger ({host}:{port})"
    elif host.startswith("157.240.") or host.startswith("57.144."):
        return f"Meta / Facebook ({host}:{port})"
    elif port == "5222":
        return f"WhatsApp Messaging ({host}:{port})"
    elif "ip.sb" in h or "ip-api" in h or "ifconfig" in h or "icanhazip" in h or "checkip" in h:
        return f"IP Checker / Speedtest ({host}:{port})"
    elif host in ["1.1.1.1", "1.0.0.1", "cloudflare-dns.com"] or "cloudflare" in h:
        if port == "53": return f"Cloudflare DNS ({host}:53)"
        return f"Cloudflare CDN ({host}:{port})"
    elif host in ["8.8.8.8", "8.8.4.4", "dns.google"]:
        return f"Google DNS ({host}:53)"
    elif "tiktok" in h or "byteoversea" in h:
        return f"TikTok Video ({host}:{port})"
    elif "netflix" in h or "nflxvideo" in h:
        return f"Netflix Streaming ({host}:{port})"
    elif "spotify" in h:
        return f"Spotify Music ({host}:{port})"
    elif "twitter" in h or "x.com" in h:
        return f"X / Twitter ({host}:{port})"
    elif port == "443":
        return f"Web HTTPS ({host}:{port})"
    elif port == "80":
        return f"Web HTTP ({host}:{port})"
    elif port == "53":
        return f"DNS Lookup ({host}:53)"
    else:
        return f"{host}:{port}"

def format_inbound_proto(tag):
    t = tag.lower()
    if "ws" in t:
        return "VLESS WebSocket (WS TLS/CDN)"
    elif "httpupgrade" in t:
        return "VLESS HTTPUpgrade (gRPC/HTTP)"
    elif "xhttp" in t:
        return "VLESS XHTTP (Next-Gen)"
    elif "tcp" in t:
        return "VLESS Direct TCP"
    elif "grpc" in t:
        return "VLESS gRPC"
    else:
        return f"VLESS ({tag})"

def fmt_bytes(b):
    if b >= 1024**3: return f"{b / (1024**3):.2f} GB"
    if b >= 1024**2: return f"{b / (1024**2):.2f} MB"
    if b >= 1024: return f"{b / 1024:.2f} KB"
    return f"{b} B"

def fmt_remaining(exp_time):
    now = int(time.time())
    if exp_time <= now:
        return "Expired"
    diff = exp_time - now
    days = diff // 86400
    hours = (diff % 86400) // 3600
    mins = (diff % 3600) // 60
    if days > 0:
        return f"{days}h {hours}j"
    elif hours > 0:
        return f"{hours}j {mins}m"
    else:
        return f"{mins}m"

# 3. Baca Database Akun VLESS
db_path = "/etc/shvl/shvl.db"
accounts = {}
if os.path.exists(db_path):
    try:
        conn = sqlite3.connect(db_path)
        c = conn.cursor()
        c.execute("SELECT username, credential, limit_ip, quota_gb, expired_at, status, usage_tx, usage_rx FROM accounts WHERE proto='vless'")
        for r in c.fetchall():
            accounts[r[0]] = {
                "uuid": r[1],
                "limit_ip": r[2],
                "quota_gb": r[3],
                "expired_at": r[4],
                "status": r[5],
                "usage_tx": r[6] if len(r) > 6 and r[6] else 0,
                "usage_rx": r[7] if len(r) > 7 and r[7] else 0
            }
        conn.close()
    except Exception:
        pass

# 4. Baca Log Akses Xray (/var/log/xray/access.log)
log_path = "/var/log/xray/access.log"
active_users = {}
now = int(time.time())

if os.path.exists(log_path):
    try:
        with open(log_path, 'r', errors='ignore') as f:
            lines = f.readlines()[-1500:]
            for line in lines:
                if "email:" not in line:
                    continue

                # Parse timestamp: e.g. "2026/10/14 00:48:09.250710"
                parts = line.split()
                if len(parts) < 2:
                    continue
                try:
                    ts_str = parts[0] + " " + parts[1].split(".")[0]
                    log_time = int(time.mktime(time.strptime(ts_str, "%Y/%m/%d %H:%M:%S")))
                except Exception:
                    log_time = now

                # Filter aktivitas dalam 15 menit terakhir (900s)
                if (now - log_time) > 900:
                    continue

                # Parse regex format: from <IP>:<PORT> accepted <PROTO>:<TARGET>:<PORT> [<INBOUND> >> ...] email: <EMAIL>
                m = re.search(r'from\s+([0-9a-fA-F\.\:]+):([0-9]+)\s+accepted\s+(?:(tcp|udp):)?([^:]+):([0-9]+)\s+\[([^\]]+)\]\s+email:\s*(\S+)', line)
                if not m:
                    ip_match = re.search(r'from\s+([0-9a-fA-F\.\:]+):([0-9]+)', line)
                    email_match = re.search(r'email:\s*(\S+)', line)
                    if not ip_match or not email_match:
                        continue
                    client_ip = ip_match.group(1)
                    client_port = ip_match.group(2)
                    email = email_match.group(1)
                    target_host = "Unknown"
                    target_port = "-"
                    transport = "tcp"
                    inbound_raw = "vless"
                else:
                    client_ip = m.group(1)
                    client_port = m.group(2)
                    transport = m.group(3) or "tcp"
                    target_host = m.group(4)
                    target_port = m.group(5)
                    inbound_raw = m.group(6).split(">>")[0].strip()
                    email = m.group(7)

                if client_ip in ["127.0.0.1", "localhost", "::1"]:
                    continue

                if email not in active_users:
                    active_users[email] = {
                        "clients": {},
                        "last_seen": log_time,
                        "total_hits": 0
                    }

                user_entry = active_users[email]
                user_entry["total_hits"] += 1
                if log_time > user_entry["last_seen"]:
                    user_entry["last_seen"] = log_time

                # Client map per client_ip
                if client_ip not in user_entry["clients"]:
                    user_entry["clients"][client_ip] = {
                        "ports": set(),
                        "protocols": set(),
                        "destinations": [],
                        "dest_set": set(),
                        "last_seen": log_time,
                        "hits": 0
                    }

                cli = user_entry["clients"][client_ip]
                cli["hits"] += 1
                cli["ports"].add(client_port)
                cli["protocols"].add(inbound_raw)
                if log_time > cli["last_seen"]:
                    cli["last_seen"] = log_time

                if target_host != "Unknown":
                    classified = classify_target(target_host, target_port, transport)
                    if classified not in cli["dest_set"] and len(cli["destinations"]) < 6:
                        cli["dest_set"].add(classified)
                        cli["destinations"].append(classified)
    except Exception:
        pass

online_user_count = len(active_users)
total_active_clients = sum([len(u["clients"]) for u in active_users.values()])

if active_users:
    for email, data in active_users.items():
        acc = accounts.get(email, {"limit_ip": 1, "quota_gb": 0, "expired_at": now + 86400, "status": "active"})
        limit_ip = acc.get("limit_ip", 1)
        quota_gb = acc.get("quota_gb", 0)
        exp_time = acc.get("expired_at", now)

        ip_count = len(data["clients"])
        if limit_ip > 0 and ip_count > limit_ip:
            ip_status = f"{RED}{ip_count} / {limit_ip} IP [MELEBIHI LIMIT - AUTO LOCK 5M]{NC}"
        elif limit_ip > 0:
            ip_status = f"{GREEN}{ip_count} / {limit_ip} IP [NORMAL]{NC}"
        else:
            ip_status = f"{GREEN}{ip_count} IP [UNLIMITED]{NC}"

        quota_str = f"{quota_gb} GB" if quota_gb > 0 else "Unlimited"
        acc_usage = a.get("usage_tx", 0) + a.get("usage_rx", 0)
        usage_user_str = f"{fmt_bytes(acc_usage)} / {quota_str}"
        rem_user_str = fmt_remaining(exp_time)
        exp_full_str = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(exp_time))

        secs_ago = max(0, now - data["last_seen"])
        last_str = f"{secs_ago}d lalu" if secs_ago < 60 else f"{int(secs_ago/60)}m lalu"

        print(f"\n{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
        print(f" {BOLD}USER ONLINE:{NC} {GREEN}{email}{NC}  │  {BOLD}Status Login:{NC} {ip_status}")
        print(f"{CYAN}─────────────────────────────────────────────────────────────────────────────{NC}")
        print(f"  {WHITE}Usage / Batas{NC}  : {YELLOW}{usage_user_str}{NC}")
        print(f"  {WHITE}Expired Pada{NC}   : {exp_full_str} ({GREEN}{rem_user_str}{NC})")
        print(f"  {WHITE}Total Aktivitas{NC}: {GREEN}{data['total_hits']} requests{NC} (Terakhir {last_str})")

        # Cetak rincian per client connection
        for idx, (client_ip, cli_info) in enumerate(data["clients"].items(), 1):
            provider, location = get_isp_and_location(client_ip)
            ports_disp = ",".join(sorted(list(cli_info["ports"]))[:3])
            if len(cli_info["ports"]) > 3:
                ports_disp += f" (+{len(cli_info['ports'])-3})"

            proto_names = [format_inbound_proto(p) for p in cli_info["protocols"]]
            proto_str = " / ".join(proto_names) if proto_names else "VLESS Tunnel"

            cli_secs = max(0, now - cli_info["last_seen"])
            cli_last = f"{cli_secs}d lalu" if cli_secs < 60 else f"{int(cli_secs/60)}m lalu"

            print(f"\n  {BOLD}{CYAN}┌─ [ KONEKSI AKTIF #{idx} ] ──────────────────────────────────────────{NC}")
            print(f"  │ {WHITE}Protokol Tunnel{NC} : {GREEN}{proto_str}{NC}")
            print(f"  │ {WHITE}Real Client IP{NC}  : {YELLOW}{client_ip}:{ports_disp}{NC}")
            print(f"  │ {WHITE}SIM / Provider{NC}  : {BOLD}{PURPLE}{provider}{NC}")
            print(f"  │ {WHITE}Lokasi Asal IP{NC}  : {GREEN}{location}{NC}")
            print(f"  │ {WHITE}Status Koneksi{NC}  : Aktif {cli_last} ({cli_info['hits']} hits)")
            print(f"  │ {WHITE}Aktivitas Trafik{NC}:")
            if cli_info["destinations"]:
                for d in cli_info["destinations"]:
                    print(f"  │   • {GREEN}{d}{NC}")
            else:
                print(f"  │   • {GRAY}(Idle / Menunggu aktivitas browsing){NC}")
            print(f"  {BOLD}{CYAN}└───────────────────────────────────────────────────────────────────{NC}")
else:
    print(f"\n {YELLOW}[i] Belum ada aktivitas koneksi VLESS dalam 5 menit terakhir.{NC}\n")

# 5. Tabel Semua Akun VLESS Terdaftar
print(f"\n{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f"                                   {BOLD}DAFTAR SEMUA AKUN VLESS TERDAFTAR{NC}")
print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f" {BOLD}{'NO':<4} {'USERNAME':<16} {'LIMIT IP':<10} {'USAGE / BATAS':<22} {'EXPIRED PADA':<20} {'SISA WAKTU':<14} {'STATUS':<10}{NC}")
print(f"{CYAN}────────────────────────────────────────────────────────────────────────────────────────────────────{NC}")

if accounts:
    for idx, (uname, a) in enumerate(sorted(accounts.items()), 1):
        lim = f"{a['limit_ip']} IP" if a['limit_ip'] > 0 else "Unlimited"
        q = f"{a['quota_gb']} GB" if a['quota_gb'] > 0 else "Unlimited"
        acc_usage = a.get("usage_tx", 0) + a.get("usage_rx", 0)
        usage_disp = f"{fmt_bytes(acc_usage)} / {q}"
        ex_t = a['expired_at']
        rem_disp = fmt_remaining(ex_t)
        exp_full = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ex_t))

        st = a['status'].upper()
        if a['expired_at'] <= now or a['status'] == "expired":
            st_color = YELLOW
            st = "EXPIRED"
        elif st == "LOCKED":
            st_color = RED
            st = "LOCKED"
        else:
            st_color = GREEN

        is_online = f" {GREEN}●{NC}" if uname in active_users else "  "
        print(f" [{idx:<2}]{is_online}{uname:<14} {lim:<10} {usage_disp:<22} {exp_full:<20} {rem_disp:<14} {st_color}{st:<10}{NC}")
else:
    print(f" {YELLOW}Belum ada akun VLESS yang terdaftar di database.{NC}")

print(f"{CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{NC}")
print(f" {WHITE}Total Akun VLESS:{NC} {GREEN}{len(accounts)}{NC}  │  {WHITE}User Online:{NC} {GREEN}{online_user_count}{NC}  │  {WHITE}Total Klien Aktif:{NC} {GREEN}{total_active_clients}{NC}\n")

EOF
