#!/usr/bin/env bash
# ==============================================================================
# SHVL Dedicated SSH & WebSocket Menu
# Reference Architecture: William Old & Alpine SSH
# ==============================================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
NC='\033[0m'
BOLD='\033[1m'

while true; do
    clear
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e " ${BOLD}${YELLOW}             ⇱ SHVL MENU SSH, WEBSOCKET & OPENVPN ⇲             ${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  ${GREEN}[•1]${NC}  Buat Akun SSH Baru                  ${CYAN}[add-ssh]${NC}"
    echo -e "  ${GREEN}[•2]${NC}  Buat Akun Trial SSH (1 Hari)        ${CYAN}[trial-ssh]${NC}"
    echo -e "  ${GREEN}[•3]${NC}  Perpanjang Masa Aktif Akun SSH      ${CYAN}[renew-ssh]${NC}"
    echo -e "  ${GREEN}[•4]${NC}  Recovery Akun Expired               ${CYAN}[recovery]${NC}"
    echo -e "  ${GREEN}[•5]${NC}  Hapus Akun SSH                      ${CYAN}[del-ssh]${NC}"
    echo -e "  ${GREEN}[•6]${NC}  Reset Kuota Penggunaan Data         ${CYAN}[reset-quota]${NC}"
    echo -e "  ${GREEN}[•7]${NC}  Ban / Kunci Akun Manual (5m/Perm)   ${CYAN}[ban]${NC}"
    echo -e "  ${GREEN}[•8]${NC}  Unban / Buka Kunci Akun             ${CYAN}[unban]${NC}"
    echo -e "  ${GREEN}[•9]${NC}  Cek Sesi Aktif SSH, IP & Bandwidth  ${CYAN}[cek-ssh / cek]${NC}"
    echo -e "  ${GREEN}[•10]${NC} Daftar Semua Akun SSH               ${CYAN}[list-ssh / member]${NC}"
    echo -e "  ${GREEN}[•11]${NC} Cetak Ulang Slip Akun SSH           ${CYAN}[slip-ssh]${NC}"
    echo -e "  ${GREEN}[•12]${NC} Cek Status IP Limiter & Multi-Login ${CYAN}[ceklim / autokill]${NC}"
    echo -e "  ${GREEN}[•13]${NC} File Konfigurasi OpenVPN (.ovpn)    ${CYAN}[ovpn]${NC}"
    echo -e "  ${GREEN}[•x]${NC}  Kembali ke Menu Utama               ${CYAN}[x / 0]${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -ne "  ${BOLD}Pilih opsi [1-13 atau x]: ${NC}"
    read -r opt

    case "$opt" in
        1|add-ssh|add)
            /usr/local/bin/shvl add-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        2|trial-ssh|trial)
            /usr/local/bin/shvl trial-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        3|renew-ssh|renew)
            /usr/local/bin/shvl renew-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        4|recovery|rec)
            /usr/local/bin/shvl recovery
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        5|del-ssh|hapus|delete)
            /usr/local/bin/shvl del-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        6|reset-quota|reset)
            /usr/local/bin/shvl reset-quota
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        7|ban|lock)
            /usr/local/bin/shvl ban
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        8|unban|unlock)
            /usr/local/bin/shvl unban
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        9|cek-ssh|cek)
            /usr/local/bin/cek-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        10|list-ssh|member|list)
            /usr/local/bin/shvl list-ssh
            ;;
        11|slip-ssh|detail)
            /usr/local/bin/shvl slip-ssh
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        12|ceklim|autokill|limit)
            /usr/local/bin/shvl limit
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        13|ovpn)
            DOMAIN=$(head -n 1 /etc/shvl/domain 2>/dev/null || curl -s --connect-timeout 2 ifconfig.me 2>/dev/null || echo "127.0.0.1")
            echo -e "\n${BOLD}${CYAN}=== DAFTAR FILE KONFIGURASI OPENVPN ===${NC}"
            ls -lh /etc/shvl/ovpn/*.ovpn /etc/shvl/ovpn/*.zip 2>/dev/null || echo "File .ovpn belum dibuat atau berada di /etc/shvl/ovpn/."
            echo -e "\n${YELLOW}URL Unduhan Langsung (Direct Download HTTPS/HTTP):${NC}"
            echo -e "  • TCP 1194 : ${GREEN}https://$DOMAIN/client-tcp-1194.ovpn${NC}"
            echo -e "  • TCP 443  : ${GREEN}https://$DOMAIN/client-tcp-443.ovpn${NC}"
            echo -e "  • TCP SSL  : ${GREEN}https://$DOMAIN/client-tcp-ssl.ovpn${NC}"
            echo -e "  • TCP WS   : ${GREEN}https://$DOMAIN/client-tcp-ws.ovpn${NC}"
            echo -e "  • All ZIP  : ${GREEN}https://$DOMAIN/openvpn.zip${NC}"
            echo -e "\n${YELLOW}Lokasi File di Server:${NC}"
            echo -e "  • /etc/shvl/ovpn/"
            echo ""
            read -r -p "Tekan [ENTER] untuk kembali..."
            ;;
        0|x|X|exit|q)
            break
            ;;
        *)
            echo -e "${RED}Pilihan tidak valid!${NC}"
            sleep 1
            ;;
    esac
done
