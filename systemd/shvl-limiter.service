[Unit]
Description=SHVL Multi-Login IP Limiter & Quota Daemon
Documentation=https://github.com/mann-bott/shvl
After=network.target ssh-ws.service xray.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/shvl limit daemon
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
